{
  "name": "tku-bridge-table",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:visual": "playwright test",
    "eval": "node --experimental-strip-types --disable-warning=ExperimentalWarning eval/cli.ts",
    "eval:gate": "node --experimental-strip-types --disable-warning=ExperimentalWarning eval/gate.ts",
    "quiz": "node --experimental-strip-types --disable-warning=ExperimentalWarning eval/quiz-cli.ts",
    "quiz:play": "node --experimental-strip-types --disable-warning=ExperimentalWarning eval/play-quiz-cli.ts",
    "sim": "node --experimental-strip-types --disable-warning=ExperimentalWarning eval/sim/cli.ts",
    "seed": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/seed-cli.ts",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.1.0",
    "@fontsource-variable/noto-sans-tc": "^5.3.1",
    "bridge-dds": "^1.4.0",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4",
    "styled-components": "^6.6.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.64.0",
    "@cloudflare/workers-types": "^5.20261021.1",
    "@playwright/test": "1.64.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.3",
    "oxlint": "^1.89.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "wrangler": "^4.151.3"
  }
}
