{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tku-bridge-table",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-09-01",
  "observability": { "enabled": true },
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/ws"]
  },
  "durable_objects": {
    "bindings": [{ "name": "CLUB", "class_name": "Club" }]
  },
  // The free plan only offers SQLite-backed Durable Objects
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Club"] }],
  "vars": {
    // Account cap for the club; INVITE_CODE is a secret (wrangler secret put INVITE_CODE)
    "MAX_USERS": "10"
  }
}
