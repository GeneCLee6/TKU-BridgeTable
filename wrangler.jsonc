{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tku-bridge-table",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-09-01",
  "observability": { "enabled": true },
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/ws", "/ws/*"]
  },
  "durable_objects": {
    // The club, and one object per table (ARCHITECTURE.md §5.10)
    "bindings": [
      { "name": "CLUB", "class_name": "Club" },
      { "name": "TABLE", "class_name": "TableObject" }
    ]
  },
  // The free plan only offers SQLite-backed Durable Objects. v2 adds the tables' objects (H1b);
  // migrations only ever add: never edit or remove one that was deployed (DEPLOY.md)
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Club"] },
    { "tag": "v2", "new_sqlite_classes": ["TableObject"] }
  ],
  // Daily backups (worker/backup.ts). Create the bucket once before the first deploy with it:
  //   npx wrangler r2 bucket create tku-bridge-backups      (DEPLOY.md §4.4)
  // Production only: the envs below have no BACKUPS binding and no cron, so staging and previews
  // never write to (or restore from) production's bucket
  "r2_buckets": [{ "binding": "BACKUPS", "bucket_name": "tku-bridge-backups" }],
  // The history pages' D1 copy (ARCHITECTURE.md §5.12), production's own database. Create it once
  // before the first deploy with it and paste its id here (DEPLOY.md §4.5):
  //   npx wrangler d1 create tku-bridge-history
  // Never give staging or previews this id: each env below has its own database or none
  "d1_databases": [
    { "binding": "HISTORY", "database_name": "tku-bridge-history", "database_id": "PASTE-PRODUCTION-D1-ID-HERE" }
  ],
  // 19:00 UTC is 03:00 in Taiwan
  "triggers": { "crons": ["0 19 * * *"] },
  "vars": {
    // Account cap for the club; INVITE_CODE is a secret (wrangler secret put INVITE_CODE)
    "MAX_USERS": "10"
  },
  // Staging and PR previews (DEPLOY.md §2.1): separate Workers, so each has its own Durable Object
  // namespace and storage and never touches production data. Pick one at build time with
  // CLOUDFLARE_ENV=staging|preview (the Vite plugin bakes it into dist/); `wrangler deploy` then
  // deploys the built config. Bindings and vars are not inherited from the top level: every
  // Durable Object binding above must be repeated in each env below (migrations are shared).
  // Secrets are per Worker too: these never get production's INVITE_CODE or ANTHROPIC_API_KEY.
  "env": {
    "staging": {
      "name": "tku-bridge-table-staging",
      "durable_objects": {
        "bindings": [
          { "name": "CLUB", "class_name": "Club" },
          { "name": "TABLE", "class_name": "TableObject" }
        ]
      },
      "vars": { "MAX_USERS": "30" },
      // Staging's own D1 copy of the history (never production's): npx wrangler d1 create tku-bridge-history-staging
      "d1_databases": [
        { "binding": "HISTORY", "database_name": "tku-bridge-history-staging", "database_id": "PASTE-STAGING-D1-ID-HERE" }
      ],
      // No backups here (triggers are inherited, r2_buckets are not): see "r2_buckets" above
      "triggers": { "crons": [] }
    },
    // Each pull request deploys its own Worker, tku-bridge-table-pr-<number> (`wrangler deploy --name`),
    // deleted when the pull request closes. No D1 here (d1_databases are not inherited): one database
    // would be shared by every preview and mix their clubs' boards, so their history stays in the club
    "preview": {
      "name": "tku-bridge-table-preview",
      "durable_objects": {
        "bindings": [
          { "name": "CLUB", "class_name": "Club" },
          { "name": "TABLE", "class_name": "TableObject" }
        ]
      },
      "vars": { "MAX_USERS": "30" },
      // No backups here (triggers are inherited, r2_buckets are not): see "r2_buckets" above
      "triggers": { "crons": [] }
    }
  }
}
